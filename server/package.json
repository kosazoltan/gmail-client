{
  "name": "gmail-client-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Gmail kliens szerver - Express + TypeScript",
  "engines": {
    "node": ">=20.18.1"
  },
  "overrides": {
    "glob": "^10.4.5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --max-old-space-size=384 --expose-gc dist/server.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "db:init": "tsx src/scripts/init-neon-schema.ts",
    "db:migrate:rfc2047": "tsx src/scripts/migrate-decode-rfc2047-email-fields.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@sentry/node": "^10.48.0",
    "@types/nodemailer": "^7.0.11",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.18.1",
    "googleapis": "^171.0.0",
    "helmet": "^8.0.0",
    "keytar": "^7.9.0",
    "mammoth": "^1.11.0",
    "nodemailer": "^8.0.2",
    "openai": "^6.27.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.19.13",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.18.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.4"
  }
}

# Szerver konfiguráció
PORT=5000

# Domain konfiguráció
# Lokális fejlesztés:
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Production (Vercel + Render, saját domain):
# FRONTEND_URL=https://mail.mindenes.org
# BACKEND_URL=https://api.mindenes.org
# ALLOWED_ORIGINS=https://api.mindenes.org,https://staging.mindenes.org
# ADDITIONAL_ORIGINS=https://api.mindenes.org,https://staging.mindenes.org

# Google OAuth2 - Google Cloud Console-ból
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth redirect URI
# Lokális: http://localhost:5000/api/auth/callback
# Production: https://api.mindenes.org/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Session titkosítás - generálj egy random stringet
# Példa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_random_secret_string

# Token titkosítás (AES-256) - 32 karakter hex kulcs szükséges
# Példa: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=change_this_to_a_32_char_hex_key_00

# PostgreSQL (Neon) — dedikált ZMail DB: Neon Console → pooled connection string
# Render: gmail-client-api → Environment → DATABASE_URL (ugyanaz a sor)
# Egyetlen Neon/Postgres connection string (Render: Environment → DATABASE_URL; host a Neon konzolból)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Opcionális: ZMail táblák dedikált PostgreSQL sémában (pl. megosztott Neon példány + más app a public-ban).
# Csak ÚJ/üres adatbázison! Részletek: server/docs/NEON-AND-DATABASE.md
# ZMAIL_PG_SCHEMA=zmail

# Szinkronizálás beállítások
SYNC_DAYS_BACK=30
SYNC_INTERVAL_MS=120000

# VAPID kulcsok push értesítésekhez (opcionális)
# Generálás: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:your-email@example.com

# Anthropic API (Claude AI elemzésekhez) - KÖTELEZŐ a piaci elemzéshez
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Piaci adatok API kulcsok (opcionális, fallback nélkülük is működik) ---

# TwelveData - Forex árfolyamok (800 hívás/nap ingyenes)
# Regisztráció: https://twelvedata.com/register
TWELVEDATA_API_KEY=

# Finnhub - GBP/HUF árfolyam + hírek (60 hívás/perc ingyenes)
# Regisztráció: https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage - Hír sentiment elemzés (5 hívás/perc ingyenes)
# Regisztráció: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
